# Production Environment Variables  
# Copy this to .env.production and fill in your values  
  
# Application  
APP_ENV=production  
APP_DEBUG=false  
APP_PORT=8080  
  
# Database  
DB_HOST=db  
DB_PORT=3306  
DB_NAME=cursoft  
DB_USER=cursoft_user  
DB_PASSWORD=your_secure_password_here  
MYSQL_ROOT_PASSWORD=your_root_password_here 
